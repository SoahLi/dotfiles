#!/usr/bin/env bash

touch "$HOME/dotfiles/misc/package_lists/pacman_packages.txt"
touch "$HOME/dotfiles/misc/package_lists/aur_packages.txt"

# Ensure files exist and overwrite with current package lists
sudo pacman -Qen > "$HOME/dotfiles/misc/package_lists/pacman_packages.txt"
sudo yay -Qem > "$HOME/dotfiles/misc/package_lists/aur_packages.txt"
