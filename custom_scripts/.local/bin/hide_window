#!/usr/bin/env bash

STORAGE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hide_window"
STORAGE_FILE="${STORAGE_DIR}/hidden_window"
mkdir -p "$STORAGE_DIR"

# Get focused window info: address, class, workspace id, and workspace name
get_focused_window_info() {
    hyprctl activewindow -j | jq -r '"\(.address)|\(.class)|\(.workspace.id)|\(.workspace.name)"'
}

# Determine where to restore by checking the monitor's state directly:
get_destination_workspace() {
    hyprctl monitors -j | jq -r '.[] | select(.focused == true) | if .specialWorkspace.id < 0 then .specialWorkspace.name else .activeWorkspace.name end'
}

if [[ -f "$STORAGE_FILE" ]]; then
    # ---------- RESTORE ----------
    stored_address=$(jq -r '.address' "$STORAGE_FILE")
    stored_class=$(jq -r '.class' "$STORAGE_FILE")

    # Check if the window still exists
    current_address=$(hyprctl clients -j | jq -r ".[] | select(.address == \"$stored_address\") | .address")
    if [[ -z "$current_address" ]]; then
        echo "Window '$stored_class' no longer exists – removing storage."
        rm -f "$STORAGE_FILE"
        exit 1
    fi

    dest_workspace=$(get_destination_workspace)
    hyprctl dispatch movetoworkspace "$dest_workspace,address:$current_address"
    hyprctl dispatch focuswindow "address:$current_address"
    rm -f "$STORAGE_FILE"
    echo "Restored window: $stored_class to workspace $dest_workspace"

else
    # ---------- HIDE ----------
    win_info=$(get_focused_window_info)
    if [[ -z "$win_info" ]]; then
        echo "No focused window found."
        exit 1
    fi

    IFS='|' read -r win_address win_class win_workspace_id win_workspace_name <<< "$win_info"
    current_workspace_name=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .activeWorkspace.name')
    current_workspace_id=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .activeWorkspace.id')

    win_workspace_num=$((win_workspace_id))
    current_workspace_num=$((current_workspace_id))

    # If window is on a special workspace (negative id), hide it unconditionally.
    # Otherwise, only hide if it's on the current regular workspace.
    if [[ $win_workspace_num -lt 0 ]]; then
        echo "{\"address\":\"$win_address\",\"class\":\"$win_class\"}" > "$STORAGE_FILE"
        hyprctl dispatch movetoworkspacesilent "4,address:$win_address"
        echo "Hidden special-workspace window: $win_class ($win_address)"
    elif [[ $win_workspace_num -eq $current_workspace_num ]]; then
        echo "{\"address\":\"$win_address\",\"class\":\"$win_class\"}" > "$STORAGE_FILE"
        hyprctl dispatch movetoworkspacesilent "4,address:$win_address"
        echo "Hidden window: $win_class ($win_address)"
    else
        echo "Window is not on current workspace (window workspace: $win_workspace_num, current: $current_workspace_num)"
        exit 1
    fi
fi
