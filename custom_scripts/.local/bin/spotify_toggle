#!/usr/bin/env bash

launch_spotify() {
    if ! pgrep -x "spotify" > /dev/null; then
        nohup /home/owen/.local/share/spotify-launcher/install/usr/share/spotify/spotify >/dev/null 2>&1 &
        sleep 1
        if pgrep -x "spotify" > /dev/null; then
            return 0  # Successfully launched
        else
            return 1  # Failed to launch
        fi
    else
        return 1  # Already running
    fi
}

get_win_address() {
    hyprctl clients -j | jq -r '.[] | select(.class == "Spotify") | .address' | head -n1
}

ensure_floating() {
    local WIN_ADDRESS="$1"
    local IS_FLOATING
    IS_FLOATING=$(hyprctl clients -j | jq -r ".[] | select(.address == \"$WIN_ADDRESS\") | .floating")
    if [[ "$IS_FLOATING" == "false" ]]; then
        hyprctl dispatch togglefloating "address:$WIN_ADDRESS"
        hyprctl dispatch resizewindowpixel "exact 700 400,address:$WIN_ADDRESS"
    fi
}

move_window_center() {
    local WIN_ADDRESS="$1"
    local MONITOR_JSON MONITOR_X MONITOR_Y MONITOR_WIDTH MONITOR_HEIGHT
    local WIN_JSON WIN_WIDTH WIN_HEIGHT NEW_X NEW_Y

    MONITOR_JSON=$(hyprctl monitors -j | jq '.[] | select(.focused == true)')
    MONITOR_X=$(echo "$MONITOR_JSON" | jq '.x')
    MONITOR_Y=$(echo "$MONITOR_JSON" | jq '.y')
    MONITOR_WIDTH=$(echo "$MONITOR_JSON" | jq '.width')
    MONITOR_HEIGHT=$(echo "$MONITOR_JSON" | jq '.height')

    WIN_JSON=$(hyprctl clients -j | jq ".[] | select(.address == \"$WIN_ADDRESS\")")
    WIN_WIDTH=$(echo "$WIN_JSON" | jq '.size[0]')
    WIN_HEIGHT=$(echo "$WIN_JSON" | jq '.size[1]')

    NEW_X=$((MONITOR_X + (MONITOR_WIDTH - WIN_WIDTH) / 2))
    NEW_Y=$((MONITOR_Y + (MONITOR_HEIGHT - WIN_HEIGHT) / 2))

    hyprctl dispatch movewindowpixel "exact $NEW_X $NEW_Y,address:$WIN_ADDRESS"
}

# ── Main ────────────────────────────────────────────────────────────────────────

launch_spotify
SPOTIFY_LAUNCHED=$?

WIN_ADDRESS=$(get_win_address)
if [[ -z "$WIN_ADDRESS" ]]; then
    echo "Could not find the Spotify window. Exiting."
    exit 1
fi

ensure_floating "$WIN_ADDRESS"

# Get current monitor and workspace states
MONITOR_JSON=$(hyprctl monitors -j | jq '.[] | select(.focused == true)')
IS_SPECIAL_ACTIVE=$(echo "$MONITOR_JSON" | jq -r '.specialWorkspace.name // ""')
CURRENT_REGULAR_WORKSPACE=$(echo "$MONITOR_JSON" | jq -r '.activeWorkspace.name')

# Determine exactly what workspace the user is currently looking at
if [[ -n "$IS_SPECIAL_ACTIVE" ]]; then
    TARGET_WORKSPACE="$IS_SPECIAL_ACTIVE" # e.g., "special:magic"
else
    TARGET_WORKSPACE="$CURRENT_REGULAR_WORKSPACE" # e.g., "1", "2", etc.
fi

# Get current window workspace placement
WIN_WORKSPACE=$(hyprctl clients -j | jq -r ".[] | select(.address == \"$WIN_ADDRESS\") | .workspace.name")

SHOULD_CENTER=true

if [[ "$SPOTIFY_LAUNCHED" -eq 0 ]]; then
    # Freshly launched → bring it into your current view context (special or regular)
    hyprctl dispatch movetoworkspace "$TARGET_WORKSPACE,address:$WIN_ADDRESS"

elif [[ "$WIN_WORKSPACE" == "$TARGET_WORKSPACE" ]]; then
    # Spotify is already right in front of you → dismiss it to workspace 6
    hyprctl dispatch movetoworkspacesilent "6,address:$WIN_ADDRESS"
    SHOULD_CENTER=false

else
    # Spotify is somewhere else → pull it into your current view context (special or regular)
    hyprctl dispatch movetoworkspace "$TARGET_WORKSPACE,address:$WIN_ADDRESS"
fi

if [[ "$SHOULD_CENTER" == "true" ]]; then
    move_window_center "$WIN_ADDRESS"
fi
